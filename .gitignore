# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.lock
!pubspec.lock

# Localização: regenerado automaticamente (flutter build/run/pub get, por
# causa de `generate: true` no pubspec.yaml) a partir dos .arb em lib/l10n/
# — só os .arb (fonte) são versionados.
lib/l10n/app_localizations*.dart
l10n_untranslated.txt

# Native build outputs
native/build/
native/output/

# Instalador gerado (binário, refeito a cada release)
installer/output/
native/third_party/vcpkg/buildtrees/
native/third_party/vcpkg/downloads/
native/third_party/vcpkg/packages/
native/third_party/vcpkg/installed/
native/third_party/vcpkg/vcpkg.exe
native/third_party/vcpkg/vcpkg

# Flutter platform folders: caminhos/ferramentas locais da máquina, não do projeto
**/ephemeral/
android/local.properties
android/.gradle/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.podspec
macos/Pods/
macos/.symlinks/

# IDE
.idea/
*.iml
.vscode/

# OS
Thumbs.db
.DS_Store
